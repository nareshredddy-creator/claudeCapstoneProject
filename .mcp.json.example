{
  "_comment": "Copy this file to .mcp.json and fill in your values. .mcp.json is git-ignored — never commit it.",
  "servers": {
    "Atlassian-MCP": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL":        "${JIRA_URL}",
        "JIRA_USERNAME":   "${JIRA_USERNAME}",
        "JIRA_API_TOKEN":  "${JIRA_API_TOKEN}"
      }
    },
    "GitHub-MCP": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
